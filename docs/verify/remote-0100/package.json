{
  "name": "dsh-firefight-mod-tools",
  "version": "0.1.0",
  "description": "DSH plugin: read the Firefight mod data through the firefight-mod-editor CLI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiancaoAwa/dsh-firefight-mod-tools.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "firefight",
    "mod"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "1.8.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  }
}
